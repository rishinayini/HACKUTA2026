# Fill these in privately. All three LiveKit values must belong to one project.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# A Gemini API key from https://aistudio.google.com/apikey (Live API access).
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY

# The Gemini Live model. Leave as is unless you are testing another one.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=team-otter-video

# FaceTime line to call from the Mac running the web app (include country code).
FACETIME_LINE=+15551234567

# NVIDIA hosted Nemotron, for delegated reasoning. A key from https://build.nvidia.com.
# Leave NVIDIA_API_KEY empty to run without delegation.
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Time limit for one delegated request, in milliseconds (default 10000). Workflow reviews took 8 to 17 seconds in tests.
NEMOTRON_TIMEOUT_MS=25000

# NVIDIA hosted Parakeet writes the transcript of the caller, using the same NVIDIA key.
# Set PARAKEET=off to use Gemini's own transcript instead. The function id selects the model
# (default: Parakeet CTC 1.1B, the streaming one).
PARAKEET=on
# PARAKEET_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081

# Turn-taking. VAD_SILENCE_MS is how long the caller must be quiet before Gemini answers
# (default 500). NOISE_CANCELLATION=off disables background voice cancellation.
# VAD_SILENCE_MS=500
# NOISE_CANCELLATION=on

# The still-image Gemini model that reads small text on a diagram, and its time limit in milliseconds.
# DIAGRAM_MODEL=gemini-3.5-flash-lite
# DIAGRAM_TIMEOUT_MS=20000

# SHOW_TRANSCRIPT=on prints what was said in the agent's terminal during a call. Off by default.
# SHOW_TRANSCRIPT=on
# BARGE_IN=on lets the caller interrupt the agent mid-answer. Off by default, for noisy rooms.
# BARGE_IN=on

# Optional Tiger Data / Tiger Cloud PostgreSQL connection string for call telemetry.
# Copy the connection string from Tiger Console and append sslmode=require if needed.
# Example: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
TIGER_DATABASE_URL=
